PORT=8080
ENV=development

# Production: connect your custody provider (BitGo, Fireblocks, etc.)
# BITGO_ACCESS_TOKEN=
# BITGO_WALLET_ID=
# BITGO_ENV=prod

# Production: connect your payment rails (SEPA, SWIFT)
# RAILS_API_KEY=
# RAILS_ENDPOINT=

# PostgreSQL (replace in-memory store)
# DATABASE_URL=postgres://user:pass@host:5432/vonix_api?sslmode=require

# Redis (for rate limiting and idempotency)
# REDIS_URL=redis://localhost:6379
